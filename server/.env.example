# Copy to .env on the host. NEVER commit the real .env.
PORT=4000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/greencart
JWT_SECRET=<long random string>
STRIPE_SECRET_KEY=sk_live_...
# From the Stripe dashboard webhook endpoint (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
SELLER_EMAIL=seller@example.com
SELLER_PASSWORD=<seller password>
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URLS=https://grocery-ordering-system.vercel.app
CLOUDINARY_CLOUND_NAME=<cloudinary cloud name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>
